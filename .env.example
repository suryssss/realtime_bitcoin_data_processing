# ==============================================================================
# MarketPulse — Environment Configuration Template
# Copy this file to '.env' and fill in your actual Confluent Cloud credentials.
# Do NOT commit '.env' to version control!
# ==============================================================================

# Supported Crypto Pairs (comma-separated, e.g. BTC-USD,ETH-USD,SOL-USD)
PRODUCTS=BTC-USD,ETH-USD,SOL-USD

# Kafka Cluster Configuration (Confluent Cloud)
BOOTSTRAP_SERVERS=pkc-xxxxx.us-east-2.aws.confluent.cloud:9092
KAFKA_API_KEY=YOUR_KAFKA_API_KEY
KAFKA_API_SECRET=YOUR_KAFKA_API_SECRET

# Schema Registry Configuration (Confluent Cloud)
SCHEMA_REGISTRY_URL=https://psrc-xxxxx.us-east-2.aws.confluent.cloud
SCHEMA_REGISTRY_API_KEY=YOUR_SCHEMA_REGISTRY_API_KEY
SCHEMA_REGISTRY_API_SECRET=YOUR_SCHEMA_REGISTRY_API_SECRET

